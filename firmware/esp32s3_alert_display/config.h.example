// Copy this file to `config.h` (git-ignored) and fill in your own values.
// The sketch will not compile without `config.h`.

// Wi-Fi network shared with the machine that runs the Sentinel dashboard (2.4 GHz only).
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// mDNS name: the display answers at http://<hostname>.local
#define SENTINEL_HOSTNAME   "sentinel-display"

// Shared secret the dashboard sends in the `X-Sentinel-Token` header.
// Must match SENTINEL_DISPLAY_TOKEN on the dashboard side. Empty string disables the check.
#define SENTINEL_TOKEN      "change-me"

// Demo mode: 1 = the red flashing alert screen is always on. After ACKNOWLEDGE (or POST /clear) the monitoring
// screen shows for DEMO_REALERT_DELAY_MS, then the alert comes back. 0 = normal behaviour (alert only on detection).
#define DEMO_MODE               0
#define DEMO_REALERT_DELAY_MS   60000
